# Copy to .env.local for local dev. On Railway, set these in the service's Variables tab. Never commit real values.

# --- Required ---

# Deepgram API key (server only). Must be a Member-role key or higher: it mints the short-lived browser tokens (POST /v1/auth/grant).
DEEPGRAM_API_KEY=
# Anthropic API key (server only). Used by /api/translate.
ANTHROPIC_API_KEY=
# Hash of the chapter passcode. Generate locally with: pnpm hash-passcode "your passcode"
# Format is scrypt:<salt>:<hash>. Paste it exactly; it contains no "$" so no escaping is needed.
CHAPTER_PASSCODE_HASH=
# Random secret that signs the session cookie. Generate: openssl rand -base64 32. Changing it logs everyone out.
SESSION_SECRET=

# --- Optional ---

# Lifetime in seconds of each minted Deepgram token (only needs to be valid at connect time). Default 60.
DEEPGRAM_TOKEN_TTL_SECONDS=
# Translation model id. Default: claude-haiku-5-5
TRANSLATE_MODEL=

# --- Set by the platform, do not set yourself ---
# PORT        Railway injects it; `pnpm start` binds 0.0.0.0:$PORT (falls back to 3000 locally).
# NODE_ENV    `next build` / `next start` set "production", which turns on the Secure flag for the session cookie.
