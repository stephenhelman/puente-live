# Copy to .env.local and fill in. Never commit .env.local.

# Deepgram API key (server only). Used to mint short-lived browser tokens via POST /v1/auth/grant.
DEEPGRAM_API_KEY=
# Lifetime of the minted token in seconds. The token only has to be valid when the WebSocket connects. Default 60.
DEEPGRAM_TOKEN_TTL_SECONDS=

# Anthropic API key (server only). Used by /api/translate.
ANTHROPIC_API_KEY=
# Translation model id. Default: claude-haiku-5-5
TRANSLATE_MODEL=

# Chapter passcode gate. Generate the hash with: pnpm hash-passcode "your passcode"
CHAPTER_PASSCODE_HASH=
# Random 32+ byte secret used to sign the session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=
